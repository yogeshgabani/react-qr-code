{
  "name": "react-qr-master",
  "version": "0.3.0",
  "description": "Styled QR codes for React with zero config: logos, gradients, 8 module shapes, 10 themes, WiFi/vCard/UPI/WhatsApp types, PNG/SVG/PDF export, copy & share, scannability check, camera scanner, and batch export. One tiny dependency, works with Next.js.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/core.d.ts",
        "default": "./dist/core.js"
      },
      "require": {
        "types": "./dist/core.d.cts",
        "default": "./dist/core.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "core": [
        "./dist/core.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rimraf dist && tsup",
    "dev": "concurrently \"tsup --watch\" \"vite playground --host\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:docs": "node scripts/check-docs.mjs",
    "clean": "rimraf dist",
    "playground": "vite playground --host",
    "playground:build": "vite build playground",
    "prepublishOnly": "npm run typecheck && npm test && npm run check:docs && npm run build && npm run check:dist",
    "check:dist": "node scripts/check-dist.mjs"
  },
  "keywords": [
    "react",
    "qr",
    "qrcode",
    "qr-code",
    "react-qr",
    "react-qrcode",
    "react-qr-code",
    "qrcode.react",
    "qr-generator",
    "qr-code-generator",
    "qr-code-styling",
    "styled-qr-code",
    "custom-qr-code",
    "qr-logo",
    "qr-code-with-logo",
    "qr-gradient",
    "qr-scanner",
    "qr-reader",
    "barcode",
    "wifi-qr",
    "vcard",
    "upi",
    "upi-qr",
    "whatsapp-qr",
    "payment-qr",
    "svg",
    "png",
    "pdf",
    "nextjs",
    "typescript",
    "react-component",
    "react-qr-master"
  ],
  "author": "Yogesh Gabani",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yogeshgabani/react-qr-code.git"
  },
  "homepage": "https://react-next-qrcode.netlify.app/",
  "bugs": {
    "url": "https://github.com/yogeshgabani/react-qr-code/issues"
  },
  "license": "MIT",
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    }
  },
  "dependencies": {
    "jsqr": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.1",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.5.0",
    "concurrently": "^8.2.0",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.15",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "rimraf": "^5.0.0",
    "tailwindcss": "^4.3.1",
    "tsup": "^8.5.1",
    "typescript": "^5.5.0",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=18"
  },
  "overrides": {
    "tsup": {
      "esbuild": "$esbuild"
    }
  }
}
