{
  "name": "react-qr-master",
  "version": "0.1.0",
  "description": "The ultimate all-in-one QR Code ecosystem for React — generator, scanner, studio, analytics, dynamic, batch, and 100+ templates.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "concurrently \"tsup --watch\" \"vite playground --host\"",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist",
    "playground": "vite playground --host"
  },
  "keywords": [
    "react",
    "qr",
    "qrcode",
    "qr-code",
    "qr-generator",
    "qr-scanner",
    "qr-studio",
    "wifi-qr",
    "email-qr",
    "react-component",
    "qr-svg",
    "qr-png",
    "qr-pdf",
    "react-qr-master"
  ],
  "author": "Yogesh Gabani",
  "license": "MIT",
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    }
  },
  "dependencies": {
    "@types/papaparse": "^5.5.2",
    "jspdf": "^2.5.2",
    "jsqr": "^1.4.0",
    "jszip": "^3.10.1",
    "papaparse": "^5.5.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.1",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.5.0",
    "concurrently": "^8.2.0",
    "postcss": "^8.5.15",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "rimraf": "^5.0.0",
    "tailwindcss": "^4.3.1",
    "tsup": "^8.3.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.10"
  },
  "engines": {
    "node": ">=18"
  }
}
